{
  "name": "ui-automation-framework",
  "version": "1.0.0",
  "description": "in progress",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "allure:clean": "node -e \"['allure-results','allure-report'].forEach(d=>require('fs').rmSync(d,{recursive:true,force:true}))\"",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "test:report": "npm run allure:clean && (playwright test || echo Tests finished with failures) && npm run allure:generate"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SDET-resplandor/ui-automation-framework.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/SDET-resplandor/ui-automation-framework/issues"
  },
  "homepage": "https://github.com/SDET-resplandor/ui-automation-framework#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.5",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.13.0"
  }
}
